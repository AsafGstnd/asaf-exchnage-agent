# ── Server mode ──────────────────────────────────────────────────────────────
# Controls whether the MockSupervisor fallback is allowed.
# In production the real Supervisor MUST initialise; any failure raises an error.
# Set to "development" or "test" to allow the mock fallback when the real
# Supervisor cannot be initialised (e.g. missing credentials in CI).
ENV_MODE=production
# ENV_MODE=development

# ── External services ─────────────────────────────────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX_NAME=your-index-name

# OPENAI_API_KEY=your-openai-api-key
# (or whichever LLM provider llmod_client uses)

# ── Frontend ──────────────────────────────────────────────────────────────────
# USE_API=false
# API_URL=http://localhost:8000/api
